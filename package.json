{
  "name": "@zsrobinson/shell",
  "version": "0.2.0",
  "private": true,
  "description": "Shared React app frame and shadcn Rhea components on the Flexoki palette.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css",
    "./src/theme.ts"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css",
    "./ui/*": "./src/components/ui/*.tsx",
    "./hooks/*": "./src/hooks/*.ts",
    "./blocks/*": "./src/blocks/*.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./server": "./src/server/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run build:css",
    "build:css": "tailwindcss --input src/styles.css --output /dev/null",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:charts": "playwright test"
  },
  "peerDependencies": {
    "@hono/node-server": "^1.19.0",
    "@tanstack/react-query": "^5.0.0",
    "hono": "^4.10.0",
    "jose": "^6.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.77.0",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hono/node-server": "^1.19.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/cli": "^4.3.5",
    "@tanstack/react-query": "^5.108.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "hono": "^4.10.0",
    "jose": "^6.1.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0"
  }
}
